# NOTE: if you're looking at this on AUR, this file is generated from
# https://github.com/RoversX/thinkterm/blob/main/ci/PKGBUILD.template
# by automation in the ThinkTerm repository.

pkgname=thinkterm-bin
_tag=@TAG@
pkgver=$(echo $_tag | tr - .)
pkgrel=2
pkgdesc='A workspace-first terminal built for heavy AI workflows'
arch=('x86_64')
url='https://github.com/RoversX/thinkterm'
license=('GPL-3.0-only')
provides=('thinkterm' 'wezterm')
conflicts=('thinkterm' 'wezterm')
# Don't strip: it will break the binary and it only saves ~10% anyway
options=('!strip')
makedepends=('fuse')
depends=(
  'dbus'
  'fontconfig'
  'hicolor-icon-theme'
  'libx11'
  'libxkbcommon-x11'
  'wayland'
  'xcb-util-keysyms'
  'xcb-util-wm'
)
optdepends=(
  'python-nautilus: ThinkTerm context menu in Nautilus'
)
source=(
  "wezterm::https://github.com/RoversX/thinkterm/releases/download/${_tag}/ThinkTerm-${_tag}-Ubuntu22.04-x86_64.AppImage"
)
sha256sums=(
  '@SHA256@'
)

prepare() {
  chmod +x "${srcdir}/wezterm"
}

pkgver() {
  "${srcdir}/wezterm" --version | cut -d' ' -f2 | tr - .
}

build() {
  "${srcdir}/wezterm" --appimage-extract >/dev/null
}

package() {
  install -Dm755 squashfs-root/usr/bin/thinkterm -t "${pkgdir}/usr/bin/"
  install -Dm755 squashfs-root/usr/bin/wezterm -t "${pkgdir}/usr/bin/"
  install -Dm755 squashfs-root/usr/bin/thinkterm-gui -t "${pkgdir}/usr/bin/"
  install -Dm755 squashfs-root/usr/bin/thinkterm-mux-server -t "${pkgdir}/usr/bin/"
  install -Dm644 squashfs-root/usr/share/doc/thinkterm/LICENSE.md \
                 squashfs-root/usr/share/doc/thinkterm/LICENSE-MIT \
                 squashfs-root/usr/share/doc/thinkterm/NOTICE \
                 -t "${pkgdir}/usr/share/licenses/${pkgname}"
  install -Dm644 squashfs-root/usr/share/icons/hicolor/128x128/apps/com.roversx.thinkterm.png \
                 "${pkgdir}/usr/share/icons/hicolor/128x128/apps/com.roversx.thinkterm.png"
  install -Dm644 squashfs-root/usr/share/applications/com.roversx.thinkterm.desktop \
                 "${pkgdir}/usr/share/applications/com.roversx.thinkterm.desktop"
  install -Dm644 squashfs-root/usr/share/nautilus-python/extensions/wezterm-nautilus.py \
                 "${pkgdir}/usr/share/nautilus-python/extensions/wezterm-nautilus.py"
}
