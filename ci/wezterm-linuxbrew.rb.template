class Wezterm < Formula
  desc "A GPU-accelerated cross-platform terminal emulator and multiplexer written by @wez and implemented in Rust"
  homepage "https://github.com/RoversX/thinkterm"
  url "https://github.com/RoversX/thinkterm/releases/download/@TAG@/ThinkTerm-@TAG@-Ubuntu20.04.AppImage"
  sha256 "@SHA256@"
  head "https://github.com/RoversX/thinkterm/releases/download/nightly/ThinkTerm-nightly-Ubuntu20.04.AppImage"

  def install
    Dir.glob("*.AppImage").each do |img|
      bin.install img => "thinkterm"
      bin.install_symlink "thinkterm" => "wezterm"
    end
  end
end
