<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the generated Info.plist cannot say: the launch screen is plain
     black, the first frame of a fresh start's starry sky (LaunchSky), and
     the app has one window. The rest of the keys come from project.yml's
     INFOPLIST_KEY_ settings. -->
<plist version="1.0">
<dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- One window, an iPad's too: a host's session (its terminal size
	     among it) and the app lock are the app's, not a window's. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- Export compliance: standard encryption (SSH, tailnet, TLS). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
</dict>
</plist>
