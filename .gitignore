# Packaging output. The ThinkTerm-/thinkterm- names are what ci/deploy.sh and
# ci/appimage.sh produce now; the WezTerm-/wezterm- ones above are kept for
# anything left over from before the rename.
/ThinkTerm-*.zip
/ThinkTerm-*.exe
/ThinkTerm-*.AppImage
/ThinkTerm-*.AppImage.zsync
/ThinkTerm-macos-*
/thinkterm*.deb
/thinkterm*.rpm
/thinkterm*.tar.xz
/thinkterm*.tar.gz
/thinkterm.spec
/thinkterm.rb

*.md

# Keep ThinkTerm-specific design documentation under version control.
!/docs/
/docs/*
!/docs/thinkterm/
!/docs/thinkterm/*.md

# Keep CI documentation under version control despite the blanket *.md rule.
!/ci/legacy-workflows/README.md

# well...
/.claude

# Built browser bundle (ci/build-web.sh): wasm-bindgen's pkg/, the fonts,
# and the page Vite builds from thinkterm-web/ui
/thinkterm-web/www/pkg/
/thinkterm-web/www/fonts/
/thinkterm-web/www/assets/
/thinkterm-web/www/index.html
/thinkterm-web/www/schemes.json
/thinkterm-web/www/*.gz
/thinkterm-web/ui/node_modules/

# Local credentials and native release output. The privacy hook also rejects
# these if they are force-added; ignore rules do not protect tracked files.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.p12
*.pfx
*.keystore
*.jks
*.apk
*.aab
*.ipa
*.dmg

!/ci/PRIVACY.md
