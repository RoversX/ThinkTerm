<?xml version="1.0" encoding="utf-8"?>
<!-- The icon as one picture: the frameless ThinkTerm icon's inside, its
     rim and corners left off, over the launcher's visible area and a little
     past it, and around it its outermost row of the dot grid, background and
     all, repeated out to the layer's edges: a launcher that shows more than
     the usual area finds the same gradient and dots there, with no edge or
     ring. One picture, not a glyph over a background, because the chevron's
     liquid glass is Icon Composer's rendering over that background. The
     system cuts it to the launcher's shape. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_art" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
