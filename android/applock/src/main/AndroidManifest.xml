<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The system's face, fingerprint or screen-lock check (BiometricPrompt). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application>
        <!-- The lock's own screen, over the app's in the app's task. -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:theme="@style/Theme.AppLock"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|uiMode|density|fontScale|locale|layoutDirection" />
    </application>
</manifest>
